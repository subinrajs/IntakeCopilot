# ---- Database ----
# The API and worker connect as a member of app_role (insert-only audit trail and AI outputs).
DATABASE_URL=postgresql://intake_app:app_dev_password@localhost:5433/intakecopilot
# Migrations and seeding run as the schema owner.
DATABASE_MIGRATION_URL=postgresql://intake_owner:owner_dev_password@localhost:5433/intakecopilot

# ---- Model backend ----
# "openai" for real model calls. "dev-oracle" answers from the gold labels so the whole app runs
# without a key (outputs are labelled as simulation and never count as model metrics).
LLM_BACKEND=openai
OPENAI_API_KEY=
# Vision extraction and triage: the stronger model.
OPENAI_EXTRACT_MODEL=gpt-5.5
OPENAI_TRIAGE_MODEL=gpt-5.5
# Protocol choice among 5 retrieved candidates: the small model.
OPENAI_PROTOCOL_MODEL=gpt-5.4-mini
# Protocol and case embeddings, reduced to 384 dimensions to match protocols.embedding.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=low

# ---- App ----
# 32+ random characters. Signs session cookies.
SESSION_SECRET=
SECURE_COOKIES=false
# Password for the seeded demo accounts (intake, radiologist, radiologist2, admin).
SEED_STAFF_PASSWORD=lakeshore-demo
# Run the pipeline worker inside the API process.
RUN_WORKER=true

# ---- Public demo protections ----
MAX_UPLOADS_PER_USER_PER_DAY=40
DAILY_SPEND_CAP_USD=5
# DEMO_RESET_UTC_HOUR=8   # nightly reset of live cases (needs SEED_ALLOW_RESET=1)
