# ---- Database ----
# The API and worker connect as a member of app_role (insert-only audit trail and AI outputs).
DATABASE_URL=postgresql://intake_app:app_dev_password@localhost:5433/intakecopilot
# Migrations and seed run as the schema owner.
DATABASE_MIGRATION_URL=postgresql://intake_owner:owner_dev_password@localhost:5433/intakecopilot

# ---- OpenAI (from day 3) ----
OPENAI_API_KEY=
# Vision extraction and triage: the stronger model.
OPENAI_EXTRACT_MODEL=gpt-5.5
OPENAI_TRIAGE_MODEL=gpt-5.5
# Protocol choice among 5 retrieved candidates: the small model.
OPENAI_PROTOCOL_MODEL=gpt-5.4-mini
# Protocol and case embeddings, reduced to 384 dimensions to match protocols.embedding.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
